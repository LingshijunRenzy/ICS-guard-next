# =============================================================================
# ICS-Guard Next — 共享环境变量清单
# =============================================================================
# 使用方式：cp .env.example .env  （.env 已被 .gitignore 排除）
#
# 变量按归属标注：
#   [共享] = 两队须一致，修改需双方确认
#   [A]    = Team A (Backend + WebUI) 使用
#   [B]    = Team B (Controller + Engine + Simulator) 使用
# =============================================================================

# ---- Kafka / Redpanda (共享) ----
# [共享] 消息总线地址。Docker 内部使用服务名 redpanda，宿主机开发用 localhost
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ---- PostgreSQL (A) ----
# [A] Backend 持久化存储。Team B 禁止直连数据库（见 team-conventions.md）
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ics_guard
POSTGRES_USER=icsguard
POSTGRES_PASSWORD=icsguard-dev

# ---- Redis (A) ----
# [A] 会话缓存与限流
REDIS_HOST=redis
REDIS_PORT=6379

# ---- SDN Controller (B 提供服务, A 调用) ----
# [B] Controller REST API 监听端口
CONTROLLER_PORT=8000
# [B] OpenFlow 控制通道端口
CONTROLLER_OPENFLOW_TCP=6633
# [B] OpenFlow 管理通道端口
CONTROLLER_OPENFLOW_ADMIN=6653
# [A] Backend 连接 Controller 的 base URL
CONTROLLER_BASE_URL=http://sdn-controller:8000

# ---- App Backend (A) ----
# [A] Backend HTTP 服务端口
APP_BACKEND_PORT=8080

# ---- Web UI (A) ----
# [A] 前端开发服务器端口 (Vite dev) 或 Nginx 端口 (prod)
WEB_UI_PORT=5173

# ---- Inference Engine (B) ----
# [B] 模型文件目录（容器内挂载路径）
MODEL_DIR=/models

# ---- Device Simulator (B) ----
# [B] 模拟器运行模式: kafka | mininet
SIMULATOR_MODE=kafka
# [B] 场景配置文件路径（容器内）
SIMULATOR_SCENARIO=/scenarios/demo-small-factory.yaml
