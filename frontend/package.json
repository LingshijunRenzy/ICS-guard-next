{
  "name": "ics-guard-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts --fix && prettier --write \"src/**/*.{vue,ts,css}\"",
    "lint:check": "eslint . --ext .vue,.ts && prettier --check \"src/**/*.{vue,ts,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "tdesign-icons-vue-next": "^0.4.1",
    "tdesign-vue-next": "^1.18.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.33",
    "vue-i18n": "^11.4.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^16.8.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.59.1",
    "unplugin-auto-import": "21.0.0",
    "unplugin-vue-components": "32.0.0",
    "vite": "^8.0.10",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^3.2.7"
  }
}
